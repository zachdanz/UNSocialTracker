# Copy this file to backend/.env and fill in real values for local development.
# On Render, set these as environment variables in the service settings instead.

PORT=3000

# From your Google Cloud service account JSON key file:
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the "private_key" value from the JSON key file. Keep the \n sequences as-is (literal backslash-n).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# The ID from your Google Sheet's URL: https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
GOOGLE_SHEET_ID=

# Any random long string. Protects the /api/refresh-all endpoint, which is
# called once a day by the GitHub Actions cron in .github/workflows/daily-refresh.yml.
# (The "Refresh all" button in the app UI does not need this secret - it refreshes
# each post individually through the normal, unauthenticated per-post endpoint.)
REFRESH_CRON_SECRET=
